      "uniqueConstraints": {},
      "checkConstraints": {
        "valid_giveaway_status": {
          "name": "valid_giveaway_status",
          "value": "\"giveaways\".\"status\" IN ('pending', 'active', 'ending', 'completed')"
        },
        "started_requires_announcement_start_time_end_time": {
          "name": "started_requires_announcement_start_time_end_time",
          "value": "\"giveaways\".\"status\" NOT IN ('active', 'ending', 'completed') OR (\"giveaways\".\"announcementMessageId\" IS NOT NULL AND \"giveaways\".\"startTime\" IS NOT NULL AND \"giveaways\".\"endTime\" IS NOT NULL)"
        },
        "ending_requires_winners": {
          "name": "ending_requires_winners",
          "value": "\"giveaways\".\"status\" <> 'ending' OR \"giveaways\".\"winnersMessageId\" IS NOT NULL"
        },
        "completed_requires_time": {
          "name": "completed_requires_time",
          "value": "\"giveaways\".\"status\" <> 'completed' OR \"giveaways\".\"fullyCompletedTime\" IS NOT NULL"
        },
        "title_description_images_must_not_be_empty": {
          "name": "title_description_images_must_not_be_empty",
          "value": "trim(\"giveaways\".\"title\") <> '' AND trim(\"giveaways\".\"description\") <> '' AND trim(\"giveaways\".\"imageUrls\") <> ''"
        }
      }
